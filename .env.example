# Production values. Store secrets with your hosting provider, never in source.
APP_ENV=production
APP_URL=https://matchmelo.example
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
REVIEWER_EMAIL=your-verified-reviewer@example.com
RESEND_API_KEY=your-email-provider-key
EMAIL_FROM=Matchmelo <hello@your-verified-domain.example>
# Optional coturn relay. When present, calls use relay-only transport.
TURN_URLS=turns:turn.example.com:5349
TURN_SHARED_SECRET=your-coturn-shared-secret
